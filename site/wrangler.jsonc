{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gazehop",
  "compatibility_date": "2026-10-01",
  // worker.js only runs for video (byte ranges for Safari); all other paths are plain static assets.
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*.mp4"]
  }
}
